{
  "name": "purescript-webgpu",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "spago build -p webgpu --pedantic-packages",
    "test": "spago build -p webgpu-tests --pedantic-packages",
    "sandbox": "spago build -p webgpu-sandbox --pedantic-packages && purs-backend-es build && vite build sandbox/",
    "sandbox-dev": "spago build -p webgpu-sandbox --pedantic-packages && purs-backend-es build && vite dev sandbox/",
    "format": "purs-tidy format-in-place \"src/**/*.purs sandbox/**/*.purs\" && prettier --arrow-parens avoid --write \"src/**/*.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "prettier": "^2.8.1",
    "purescript": "0.15.16",
    "purs-backend-es": "^1.3.1",
    "purs-tidy": "^0.9.2",
    "spago": "1.0.4",
    "vite": "^4.0.4"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  }
}
